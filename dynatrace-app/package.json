{
  "name": "rocky-agent-app",
  "version": "0.2.4",
  "private": true,
  "description": "Dynatrace App for Rocky Agent, an AI agent for Dynatrace powered by Claude.",
  "license": "MIT",
  "scripts": {
    "start": "dt-app dev",
    "build": "dt-app build",
    "deploy": "dt-app deploy",
    "deploy:token": "bash scripts/deploy.sh",
    "uninstall": "dt-app uninstall",
    "info": "dt-app info",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/api/tsconfig.json",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@dynatrace-sdk/app-environment": "^1.1.6",
    "@dynatrace-sdk/app-utils": "^1.0.2",
    "@dynatrace-sdk/client-app-settings-v2": "^1.2.1",
    "@dynatrace-sdk/client-classic-environment-v2": "^9.1.0",
    "@dynatrace-sdk/client-query": "^1.28.1",
    "@dynatrace-sdk/client-resource-store": "^1.1.0",
    "@dynatrace-sdk/client-state": "^1.11.0",
    "@dynatrace-sdk/error-handlers": "^1.3.2",
    "@dynatrace-sdk/http-client": "^1.5.1",
    "@dynatrace-sdk/navigation": "^2.3.1",
    "@dynatrace-sdk/react-hooks": "^1.15.3",
    "@dynatrace-sdk/user-preferences": "^1.1.5",
    "@dynatrace/strato-components": "^3.16.1",
    "@dynatrace/strato-design-tokens": "^1.7.1",
    "@dynatrace/strato-icons": "^2.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "7.1.14",
    "react-is": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "overrides": {
    "react-intl": {
      "typescript": "$typescript"
    },
    "@microsoft/eslint-plugin-sdl": {
      "eslint": "^10.0.0"
    },
    "eslint-plugin-react": {
      "eslint": "^10.0.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "dt-app": "1.20.0",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
