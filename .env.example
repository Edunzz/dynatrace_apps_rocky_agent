# Rocky Agent: local development environment.
#
# Copy to .env (never commit it) and fill in the values:
#   cp .env.example .env
#
# Production deployments must inject secrets with the platform secret store
# (Docker secrets, AWS Secrets Manager, Azure Key Vault, Kubernetes Secrets).
# See docs/security/secrets.md.

# --- Dynatrace platform (required) -------------------------------------------
DT_PLATFORM_URL=https://abc12345.apps.dynatrace.com
# Platform token (starts with dt0s16.) of a dedicated service user.
# Scopes per profile: docs/dynatrace-setup.md (recommended: dtctl readwrite-mine list).
DT_PLATFORM_TOKEN=

# --- Runtime access ----------------------------------------------------------------
OPENCODE_SERVER_USERNAME=opencode
# Leave empty only for local development: the documented default
# (edunzzxgundam79) is applied with a warning when NODE_ENV is not production.
# Production requires a unique password of at least 16 characters.
OPENCODE_SERVER_PASSWORD=
OPENCODE_PORT=4096

# --- Model provider (pick one) --------------------------------------------------------
# OpenCode Zen:   OPENCODE_PROVIDER=opencode       + OPENCODE_API_KEY (free models work without it)
# Anthropic:      OPENCODE_PROVIDER=anthropic      + ANTHROPIC_API_KEY
# OpenAI:         OPENCODE_PROVIDER=openai         + OPENAI_API_KEY
# Amazon Bedrock: OPENCODE_PROVIDER=amazon-bedrock + AWS_REGION + AWS credentials or a task role
OPENCODE_PROVIDER=
OPENCODE_MODEL=
OPENCODE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Runtime behavior ------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
WORKSPACE_PATH=/workspace
# Comma-separated HTTPS origins allowed to call the runtime from a browser.
# Not needed when the Dynatrace App calls the runtime through its App Function.
ALLOWED_ORIGINS=
# readonly | readwrite-mine | readwrite-all
DTCTL_SAFETY_LEVEL=readwrite-mine
