# Rocky Agent runtime configuration.
#
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Fill in the three values in "REQUIRED" and choose how Claude signs in. Never commit .env.

# ===== REQUIRED ======================================================================

# Your Dynatrace environment (platform URL, not *.live.dynatrace.com).
DT_PLATFORM_URL=https://abc12345.apps.dynatrace.com

# Runtime platform token (starts with dt0s16.). Scopes: README "Getting started", step 1.
DT_PLATFORM_TOKEN=

# Password the app uses to connect to this runtime: at least 16 characters.
# Generate one, for example:  openssl rand -base64 24
ROCKY_SERVER_PASSWORD=

# ===== CLAUDE SIGN-IN (pick one) =======================================================

# a) Your Claude subscription (Pro, Max, Team, Enterprise), recommended:
#      docker compose run --rm rocky-agent login
#    Open the URL it prints, sign in, paste the code back. Nothing to set here.
# b) Your Claude subscription as a one-year token:
#      docker compose run --rm rocky-agent setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# c) An Anthropic API key (pay per use, https://platform.claude.com):
ANTHROPIC_API_KEY=
# A subscription is for your own use only; for a team use an API key or a cloud provider.

# ===== OPTIONAL ======================================================================

# Model: an alias (sonnet, opus, haiku) or a full name. Empty uses Claude Code's default.
ROCKY_MODEL=

# Amazon Bedrock instead of Anthropic (prefer a task role in the cloud):
#   CLAUDE_CODE_USE_BEDROCK=1, AWS_REGION and AWS credentials
CLAUDE_CODE_USE_BEDROCK=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

ROCKY_SERVER_USERNAME=rocky
LOG_LEVEL=info
# readonly | readwrite-mine | readwrite-all (must match the token's scopes)
DTCTL_SAFETY_LEVEL=readwrite-mine
# production (default) requires the password above. development accepts the public
# default password "edunzzxgundam79": only for localhost, never with the tunnel.
NODE_ENV=production
# Comma-separated HTTPS origins for direct browser access (not needed for the app).
ALLOWED_ORIGINS=
