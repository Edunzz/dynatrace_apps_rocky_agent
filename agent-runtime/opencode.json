{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "instructions": ["/opt/rocky/policy/AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*/.config/dtctl/*": "deny",
      "/home/rocky/.config/dtctl/*": "deny",
      "/proc/*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },
    "edit": {
      "*": "ask",
      "artifacts/*": "allow",
      "/workspace/artifacts/*": "allow",
      "rca/*": "allow",
      "rca-*/*": "allow",
      "opencode.json": "deny",
      ".opencode/*": "deny"
    },
    "bash": {
      "*": "ask",
      "dtctl version*": "allow",
      "dtctl doctor*": "allow",
      "dtctl auth whoami*": "allow",
      "dtctl get *": "allow",
      "dtctl describe *": "allow",
      "dtctl query *": "allow",
      "dtctl inventory*": "allow",
      "dtctl apply * --dry-run*": "allow",
      "python3 */check_prereqs.py*": "allow",
      "python3 */hora_local.py*": "allow",
      "node */skills/drawio/scripts/drawio-validate.mjs *": "allow",
      "ls*": "allow",
      "pwd": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "grep *": "allow",
      "jq *": "allow",
      "date*": "allow",
      "cat *dtctl/config*": "deny",
      "cat */proc/*": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv*": "deny"
    },
    "external_directory": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "skill": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow",
    "lsp": "allow",
    "doom_loop": "ask"
  }
}
