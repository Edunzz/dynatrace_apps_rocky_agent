{
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(~/.claude/skills/**)",
      "Bash(dtctl version*)",
      "Bash(dtctl doctor*)",
      "Bash(dtctl auth whoami*)",
      "Bash(dtctl get *)",
      "Bash(dtctl describe *)",
      "Bash(dtctl query *)",
      "Bash(dtctl apply * --dry-run*)",
      "Bash(python /home/rocky/.claude/skills/dt-custom-rca-jromero/scripts/check_prereqs.py*)",
      "Bash(python3 /home/rocky/.claude/skills/dt-custom-rca-jromero/scripts/check_prereqs.py*)",
      "Bash(python /home/rocky/.claude/skills/dt-custom-rca-jromero/scripts/hora_local.py *)",
      "Bash(python3 /home/rocky/.claude/skills/dt-custom-rca-jromero/scripts/hora_local.py *)",
      "Bash(node /home/rocky/.claude/skills/drawio/scripts/drawio-validate.mjs *)",
      "Edit(//workspace/artifacts/**)",
      "Edit(//workspace/rca/**)",
      "Edit(//workspace/rca-*/**)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/dtctl/**)",
      "Read(~/.rocky/**)",
      "Read(//proc/**)",
      "Read(//tmp/rocky/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Edit(~/.claude/**)",
      "Edit(~/.rocky/**)",
      "Edit(~/.config/**)",
      "Edit(//opt/rocky/**)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(cat *dtctl/config*)",
      "Bash(claude)",
      "Bash(claude *)"
    ]
  },
  "allowManagedPermissionRulesOnly": true,
  "allowManagedHooksOnly": true,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_UPDATES": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  }
}
